# Server
PORT=5000
NODE_ENV=development

# MongoDB
# MONGODB_URI=mongodb+srv://snehashankhala_db_user:TEGxGEZcSnnuwDPu@cluster0.8cdhodu.mongodb.net/?appName=Cluster0
# For MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/yt2text

# JWT
# AI Services (use one or both)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=gemini  # 'gemini' or 'openai'

# OpenRouter (optional - set OPENAI_BASE_URL and OPENROUTER_API_KEY to use)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_REFERER=http://localhost:5173
OPENROUTER_TITLE=yt2text

# Optional: use OpenAI for audio/Whisper while using OpenRouter for chat
OPENAI_AUDIO_BASE_URL=https://api.openai.com/v1
OPENAI_AUDIO_API_KEY=your_openai_api_key_here

# YouTube (optional - for fallback)
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
